# ============================================================
# GFIN Environment Configuration
# Copy this file to .env and modify as needed
# ============================================================

# ---- Dataset Paths ----
HICO_DET_ROOT=./hicodet
VCOCO_ROOT=./vcoco
VCOCO_DATA_DIR=/data/v-coco

# ---- V-COCO Evaluation Annotation Files ----
VCOCO_VSRL_ANNOT=vcoco/v-coco/data/vcoco/vcoco_test.json
VCOCO_COCO_ANNOT=vcoco/v-coco/data/instances_vcoco_all_2014.json
VCOCO_SPLIT_FILE=vcoco/v-coco/data/splits/vcoco_test.ids

# ---- Pretrained Model Paths ----
DETR_PRETRAINED_HICO=checkpoints/detr/hico_det/detr-r101-hicodet.pth
DETR_PRETRAINED_VCOCO=checkpoints/detr/vcoco/detr-r50-vcoco.pth

# ---- Training ----
NUM_GPUS=4
MASTER_ADDR=127.0.0.1
MASTER_PORT=1333
OUTPUT_DIR=./logs

# ---- Docker ----
DATA_MOUNT_PATH=/data
CHECKPOINT_MOUNT_PATH=/checkpoints
